# Copy to .env and fill in. `npm run server` loads this file automatically
# (node --env-file-if-exists), and .env is git-ignored.

# MongoDB connection string.
# Local default: `npm run db` starts a real mongod here with its data in
# .data/mongodb, so progress survives restarts.
MONGODB_URI=mongodb://127.0.0.1:27017/nexaura
# Hosted alternative (free M0): replace the line above with your Atlas string.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexaura?retryWrites=true&w=majority
# Without MONGODB_URI the API serves ephemeral in-memory progress (dev only).

# API port (default 5000). The Vite dev server proxies /api here.
# PORT=5000

# Optional local-database overrides for `npm run db`:
# MONGOD_BINARY=C:/path/to/mongod.exe
# MONGO_DB_PATH=.data/mongodb
# MONGO_PORT=27017
